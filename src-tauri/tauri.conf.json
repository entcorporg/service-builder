{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Service Builder",
  "version": "1.2.0",
  "identifier": "dev.servicebuilder.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Service Builder",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Visual builder for event-driven Rust backends",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3Mjg1MjE0RDVEQjRGMjIKUldRaVQ5dlZGRklvbDdtQjcwUHJBUVRIQ2QxS01FZy80bHBZeTdvK3UyOXpwZzROaVVlVTB6cTgK",
      "endpoints": ["https://github.com/entcorporg/service-builder/releases/latest/download/latest.json"]
    }
  }
}
